# Copy this file to .env and fill in what you have. Leave a line blank to switch that part off.
# Never commit your .env file.

# --- Q-S DAM (Getty Media Manager, runs on Brandfolder) ---
DAM_API_KEY=
DAM_LIBRARY_ID=hwj47s9kcnvsqmrvk7xzhgtx
DAM_ASSET_URL_BASE=https://dam.gettyimages.com/quigley-simpson/#!asset/

# --- Getty Images stock catalog (from your Getty account rep) ---
GETTY_API_KEY=
# Only needed if Getty says your account needs a token for search:
GETTY_API_SECRET=

# --- Chat assistant (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low, medium or high. Higher is more careful but slower.
ANTHROPIC_EFFORT=low

# --- Website ---
PORT=3000
# auto = show built-in sample DAM results only when no real source is set up. true or false to force it.
DEMO_MODE=auto
# Optional: a password for the whole site. People type it in the browser prompt;
# other tools (like Copilot Studio) send it in an "x-api-key" header.
APP_API_KEY=
